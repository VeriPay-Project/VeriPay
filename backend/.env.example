# Copy this file to .env and fill in your values.
# cp backend/.env.example backend/.env

# ── Supabase / PostgreSQL ────────────────────────────────────────────────────
DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/<dbname>
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=6543
DB_NAME=postgres
DB_SSLMODE=require

# ── App ──────────────────────────────────────────────────────────────────────
VERIPAY_ENV=development
SESSION_SECRET=change-me-to-a-long-random-string
SESSION_MAX_AGE=86400
BANK_HASH_SECRET=change-me-to-a-long-random-string

# ── Plaid (open-banking verification) ───────────────────────────────────────
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_BASE_URL=https://sandbox.plaid.com

OPEN_BANKING_PROVIDER=plaid
OPEN_BANKING_FALLBACK_TO_MOCK=true

# ── Ollama (set automatically by docker-compose, override if needed) ─────────
OLLAMA_URL=http://ollama:11434/api/generate
OLLAMA_MODEL=qwen2.5:0.5b
OLLAMA_TIMEOUT=45
OLLAMA_KEEP_ALIVE=12h
OLLAMA_NUM_CTX=1536
OLLAMA_NUM_THREAD=4
OLLAMA_MAX_RETRIES=0
OLLAMA_MAX_TEXT_CHARS=2200
